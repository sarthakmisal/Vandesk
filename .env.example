# Copy to .env (or set in your host). Development needs none of these.
NODE_ENV=production
PORT=3000
AUTH_SECRET=change-me-to-a-long-random-string        # required in production (16+ chars)
DATABASE_URL=postgres://user:password@host:5432/vandesk   # unset = built-in PGlite dev database in ./data
CRON_SECRET=another-long-random-string                # protects /api/internal/jobs/*
SMTP_HOST=smtp.example.com                            # unset = emails are only logged (development)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VanDesk <no-reply@yourdomain.com>
SEED_DEMO=0                                           # 1 = load demo people and data on an empty database
