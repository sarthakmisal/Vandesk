{
  "name": "vandesk",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "ng serve -c api",
    "build": "ng build",
    "serve": "node server/index.ts",
    "dev:api": "node --watch server/index.ts",
    "test:api": "node --test server/app.test.ts",
    "typecheck:api": "tsc -p server/tsconfig.json",
    "build:serve": "ng build && node server/index.ts",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "ionicons": "^8.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "^0.5.14",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~5.0.5"
  },
  "prettier": "@ionic/prettier-config",
  "description": "VanDesk: fees, onboarding and trips for school vans (driver, parent, admin)"
}
